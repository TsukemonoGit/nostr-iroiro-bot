{"id":"6f056aeeca2d733be086c90da4cf8ac594e85b44631e2f55bf180a45d0adc706","pubkey":"cac0e43235806da094f0787a5b04e29ad04cb1a3c7ea5cf61edc1c338734082b","created_at":1782354417,"content":"Всегда интересно было, почему Marukawa выпускает жвачку с котом Феликсом. Оказалось, там целая история. Они запустили жвачку в 62-ом и нарисовали, как им казалось, медведя, однако все быстро узнали в нём кота Феликса, что вынудило их купить лицензию на кота, но однажды владельцы лицензии сказали, что это хуйня, а не Феликс, и потребовали перерисовать.\n\nhttps://nostr.download/d540f5530e619afc21de4f3541064a8e47bb75bb2d5e74908a49b303560da175.jpg\n\nhttps://nostr.download/98cc06a3de5b513c847a2f338359977a69003a2d25fff1f2aa83ea10578a3bbf.jpg","tags":[["alt","A short note: Всегда интересно было, почему Marukawa выпускает ж..."],["r","https://nostr.download/98cc06a3de5b513c847a2f338359977a69003a2d25fff1f2aa83ea10578a3bbf.jpg"],["r","https://nostr.download/d540f5530e619afc21de4f3541064a8e47bb75bb2d5e74908a49b303560da175.jpg"],["imeta","url https://nostr.download/d540f5530e619afc21de4f3541064a8e47bb75bb2d5e74908a49b303560da175.jpg","x d540f5530e619afc21de4f3541064a8e47bb75bb2d5e74908a49b303560da175","size 5813","m image/jpeg","dim 169x110","blurhash rcMs4,XSt.RktmVst6n+xZLybb%2kCkCkWR*oze.]#f*-5s,ROr=SOniR.wdR*oes:M{RjtRV@oLI[RjK6kCS4NGxGWWs.s.RjVsjso}RjbIs:bH","ox d540f5530e619afc21de4f3541064a8e47bb75bb2d5e74908a49b303560da175"],["imeta","url https://nostr.download/98cc06a3de5b513c847a2f338359977a69003a2d25fff1f2aa83ea10578a3bbf.jpg","x 98cc06a3de5b513c847a2f338359977a69003a2d25fff1f2aa83ea10578a3bbf","size 27444","m image/jpeg","dim 897x678","blurhash #jMP:w%M?Hozk=R-aekDt7_NRjIpniWAn%aKj?f6T0s.V@a}nOofkWj@WUj]ofn~WWjbW;ozWBjZs:aye.oeShjZWUjbjbs:WVofbHj[f6V@j]a#WBjtbcayj=jun*bGkA","ox 98cc06a3de5b513c847a2f338359977a69003a2d25fff1f2aa83ea10578a3bbf"]]}
