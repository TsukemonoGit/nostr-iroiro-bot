{"id":"00009a09aa31d1764fa98e3a2caaae0d870b491e329a3760bed8c23c5ace2df1","pubkey":"3b487825307515e6d903710af238f52566df1005c7ffb9e963965f6ccc2ffb8a","created_at":1781740475,"content":"https://cdn.nostrcheck.me/a0e13e1685ae79775dffbd0e9a613167b2e5cf3628ad627481afbe167a9b002a.jpeg","tags":[["e","a50b74d525698912a3dbb48c8e70115b6b2a7842b0a22b2f62cf5bcc7e893b2c","wss://relay.primal.net","root"],["p","e3a59924933c9f9f2df83449055eb3858f1480fdd0c5edb95df08bedcd2e6624"],["imeta","url https://cdn.nostrcheck.me/a0e13e1685ae79775dffbd0e9a613167b2e5cf3628ad627481afbe167a9b002a.jpeg","m image/jpeg","thumbhash GPgNDoKGm3d/h3eIaGdpdmiIXKrw9Bo=","dim 1402x1122"],["client","Wisp"],["nonce","45650","16"]]}
{"id":"3604071798b23da25ca21349dcbea7c73e35785b487beec5450e76dd0b87cb28","pubkey":"c2e4efef6b4eace4d47abc30920b40c120b8e9b25d950e5d68325a09f8ac2e10","created_at":1781740102,"content":"【青空凍結の具体例】青空凍結の簡単な経緯です。凍結直前のアカウント状態。何故凍結したかは、おそらくパラヴァレ過去絵がパラソールのファン界隈に広がり、過去Twitterで体験した時と同じように、パラ母絶許厄介カプ厨に大量通報されたと思われます。こちらにのせられない絵なのでトリミングのみで。\n\n以前コミッションを受けていたときのリク絵でした。私は今後描かないモチーフなので、この絵の削除は説明をうけて規約違反と納得した。同じような絵は描かないから凍結を解除してくれないか？と異議申し立てしたが凍結は解除されなかったという状態です。\n\n青空はR18が投稿できたのでつづけてましたが、全年齢のみでつかうつもりがないので全年齢サブアカはありますがそちらはアカウント休止にしました。\n\nかつてTwitterでパラ母通報を何度もされていたときとおなじようなかんじですので、この状態で青空つかっても疲弊するだけだなと。青空再開の予定はありません。\n\n青空は、bluesky公式サーバに不満があったらデータとフォロワーもって別のサーバにいけるというのが当初のウリでしたが。いまだそれは技術に疎い素人目線では達成されていない状態ですね。このように凍結したらどこにもいけないんだよなあ。結局旧Twitterが凍結した時と同じだな。これが、Twitterの代替であることを優先し、分散型である当初の目標はどうしたと、技術に詳しい方々が苦言を呈していたことかと実感はしました。\n\nhttps://image.nostr.build/03e9714eb723fde14d2c3b41df6cad6b964654ede6f522e502c19b515067235a.jpg","tags":[["imeta","url https://image.nostr.build/03e9714eb723fde14d2c3b41df6cad6b964654ede6f522e502c19b515067235a.jpg","blurhash ekL;Hi9ZxuRj%L-Vt7V[ofWA_N%2bIRjR*I:RPx[M{bI%gkCbFoLRj","dim 1366x768"],["r","https://image.nostr.build/03e9714eb723fde14d2c3b41df6cad6b964654ede6f522e502c19b515067235a.jpg"],["client","Damus"]]}
