{"id":"9712a36f03cdbef0d8fd56149e4c952b86846f7e3a3ea47f84de402066e718b1","pubkey":"c2e4efef6b4eace4d47abc30920b40c120b8e9b25d950e5d68325a09f8ac2e10","created_at":1782733874,"content":"あっ、ただのよっぱらいです。イカとほやの熟成塩辛と日本酒、馬肉の塩辛とビール、静岡おでんとダシ割り堪能したりしました。\n\nだれでも気軽に入れる秋葉原ちゃばらの静岡塩辛屋さんのイートインですぞ。ただ月曜から呑む酒クズ少ないだけですな。多分。\n\nhttps://image.nostr.build/b1c8dade1d15ee3e338967bdd6540488124d5be6405c8f4db856532f260585ca.jpg\nhttps://image.nostr.build/8aca037ae2f33bdea628d39675bd9fc54ef42ec81a177b5a538bfc7e48592b83.jpg","tags":[["imeta","url https://image.nostr.build/b1c8dade1d15ee3e338967bdd6540488124d5be6405c8f4db856532f260585ca.jpg","blurhash eMGH-mE2IAM_$$0,xGWU%0oznio#RnRjbHD*xuX9I[RQIVM{%LxuR+","dim 4284x5712"],["imeta","url https://image.nostr.build/8aca037ae2f33bdea628d39675bd9fc54ef42ec81a177b5a538bfc7e48592b83.jpg","blurhash eGFhq%%L9}E1$QwN%1E1t7R+0hE1#kWVIoO=j]soaeR+MyNKW9xuoz","dim 4031x3023"],["r","https://image.nostr.build/b1c8dade1d15ee3e338967bdd6540488124d5be6405c8f4db856532f260585ca.jpg"],["r","https://image.nostr.build/8aca037ae2f33bdea628d39675bd9fc54ef42ec81a177b5a538bfc7e48592b83.jpg"],["client","Damus"]]}
{"id":"57f2a4522bfed4a5bad3f8d8db7a3e275ea476e11761658692479a7c7ac0dff5","pubkey":"23395bce1a18fe5ff5bde153fcd47ecd1cd66e686684dfd2cfcbd9fafd305cb3","created_at":1782733634,"content":"nostr:npub1ddhpnnj84ytuhcf6vlhtgpf6nvcpu78vny2p8e64f9fs3rkk95ashxgr8s \nnostr:npub1kurad0nlm8xfuxhws05pcwv5z4k0ea6da4dsjygexr77a666pssqsftsm7 \n\n部屋の状態に改善点が多いことは承知しています。また、部屋の画像を投稿したことで不快感を与えた点については、申し訳なく思っています。\n\nしかし、「ゴミカス」「死ぬか部屋掃除するかの二択」といった表現は、単なる指摘や批判の範囲を明らかに超えていると考えています。これは人格攻撃であり、到底許容できません。\n\n今回の一連の投稿については、証拠保全しました。\n\n部屋の状態についての具体的な指摘であれば受け止めますが、人格攻撃や嘲笑まで受け入れるつもりはありません。\n\n該当する投稿について、削除リクエストの発行を含む可能な範囲での削除・撤回および謝罪等の誠実な対応がない場合は、弁護士への相談、ならびに侮辱罪での告訴を含む法的対応を検討します。\n\nhttps://image.nostr.build/d35911adb32c81c9041b8c04440c813d81847bae649f4b79250af79176e73c6f.jpg\nhttps://image.nostr.build/f552427ba29a21eff94e400cf64a8c8296963ff5c9c4b5c05773523cf17c5562.jpg\nhttps://image.nostr.build/a9a8185ed301fb9472ce6b9a805f965b0a327e33027aad0eb98ab61ef2be1aa6.jpg\nhttps://image.nostr.build/032796066e35695237ef2ff7a79138a57f12b9abfdc500647edd05a3a0dc1f05.jpg\nhttps://image.nostr.build/599f361af795eb82b64fc8e1be39db114262361b435b09aa5d0b7d33d94f4aea.jpg","tags":[["imeta","url https://image.nostr.build/d35911adb32c81c9041b8c04440c813d81847bae649f4b79250af79176e73c6f.jpg","blurhash eFR:HIIVE2X7R,00WEocWCoe4Txte;t6ay4na#axWCay8_t7oejZj?","dim 1320x2868"],["imeta","url https://image.nostr.build/f552427ba29a21eff94e400cf64a8c8296963ff5c9c4b5c05773523cf17c5562.jpg","blurhash eER:KPE1E2g3Rk00V]k9WCkB00%Lafodjt00agkBa#ay9Ft6oKoLjs","dim 1320x2868"],["imeta","url https://image.nostr.build/a9a8185ed301fb9472ce6b9a805f965b0a327e33027aad0eb98ab61ef2be1aa6.jpg","blurhash e6SF@U0f0MXRWC4nN3bqRQt59G%fD*t5jGInS5IVRmWV%J%LMyafRj","dim 1320x2868"],["imeta","url https://image.nostr.build/032796066e35695237ef2ff7a79138a57f12b9abfdc500647edd05a3a0dc1f05.jpg","blurhash eTR3QPIUM{WBRk00WDk9WBfj4nt7f8ofay4nWCj[ayayD$ofj[j[az","dim 1320x2868"],["imeta","url https://image.nostr.build/599f361af795eb82b64fc8e1be39db114262361