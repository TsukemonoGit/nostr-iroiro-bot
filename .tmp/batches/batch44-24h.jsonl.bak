{"id":"4b8c82617b9b260f1f7d4c898d54259a44b7c2af55f0d36bae73ffce06ea7da8","pubkey":"deab79dafa1c2be4b4a6d3aca1357b6caa0b744bf46ad529a5ae464288579e68","created_at":1782196762,"content":"https://npub1m64hnkh6rs47fd9x6wk2zdtmdj4qkazt734d22d94ery9zzhne5qw9uaks.blossom.band/7d7b801940337552471b4ac807c78c3d74e20e22cd8ead200691d45650374f02.jpg\nnostr:nevent1qqsz4vpx4z5j0ttv6y67x0w8l9p29z92tyv3r4vjgvczfe2ezpa9r5gpz4mhxue69uhhyetvv9ujuerpd46hxtnfduhsygr0aj2fmxrtkzepduyww79vf95pe8sgm6uul5ktnz75gdmlh5r4fupsgqqqqqqsuhdnx2","tags":[["alt","A short note: https://npub1m64hnkh6rs47fd9x6wk2zdtmdj4qkazt734d2..."],["p","6fec949d986bb0b216f08e778ac49681c9e08deb9cfd2cb98bd44377fbd0754f","ws://paz.dynip.sapo.pt:4848/"],["p","deab79dafa1c2be4b4a6d3aca1357b6caa0b744bf46ad529a5ae464288579e68"],["r","https://npub1m64hnkh6rs47fd9x6wk2zdtmdj4qkazt734d22d94ery9zzhne5qw9uaks.blossom.band/7d7b801940337552471b4ac807c78c3d74e20e22cd8ead200691d45650374f02.jpg"],["q","2ab026a8a927ad6cd135e33dc7f942a288aa591911d592433024e559107a51d1","wss://relay.damus.io/","6fec949d986bb0b216f08e778ac49681c9e08deb9cfd2cb98bd44377fbd0754f"],["zap","6fec949d986bb0b216f08e778ac49681c9e08deb9cfd2cb98bd44377fbd0754f","ws://paz.dynip.sapo.pt:4848/","0.5"],["zap","deab79dafa1c2be4b4a6d3aca1357b6caa0b744bf46ad529a5ae464288579e68","wss://nostr.wine/","0.5"],["imeta","url https://npub1m64hnkh6rs47fd9x6wk2zdtmdj4qkazt734d22d94ery9zzhne5qw9uaks.blossom.band/7d7b801940337552471b4ac807c78c3d74e20e22cd8ead200691d45650374f02.jpg","x 7d7b801940337552471b4ac807c78c3d74e20e22cd8ead200691d45650374f02","size 50486","m image/jpeg","dim 1280x720","blurhash i6BC_inKFY?GnLyZ$e-WX4-q-V%L%2WnXTV@oJX90gIVruEQ9tZ$WGI@i_ENIVIVI=RjnjR.M|oM%Lt5SJxu%1S1oyxZe-","ox 7d7b801940337552471b4ac807c78c3d74e20e22cd8ead200691d45650374f02"],["client","Amethyst"]]}
