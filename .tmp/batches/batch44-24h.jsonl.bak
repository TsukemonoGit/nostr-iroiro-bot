{"id":"ee89ef4dbc679ff732e9dcaaf0e7f08f4c311534e980cf5e65c796a2ad0e6e2c","pubkey":"6e75f7972397ca3295e0f4ca0fbc6eb9cc79be85bafdd56bd378220ca8eee74e","created_at":1782201673,"content":"https://npub1de6l09erjl9r990q7n9ql0rwh8x8n059ht7a267n0q3qe28wua8q20q0sd.blossom.band/090fd9d059bd14e730ce9f3d32fbd497ec91b2b63f1cf2b1d227d7b3dd8244db.png","tags":[["e","882ca327b1f76a6bfed4d906cbab8e4e5f677399dbd955d395f555eba23c2f64","wss://nostr.wine/","root","314072c16fa9433e1374f62e5b02c8163946ed298a9cde3b1541513c29d19fff"],["e","61320eac8c09a0e590bd4e5c2e0ba5f83fcb0edff3f8c25d7cd8f313aa2f435c","wss://nostr.wine/","reply","314072c16fa9433e1374f62e5b02c8163946ed298a9cde3b1541513c29d19fff"],["p","314072c16fa9433e1374f62e5b02c8163946ed298a9cde3b1541513c29d19fff","wss://nostr.wine/"]]}
